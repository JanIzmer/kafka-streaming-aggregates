# ---------------------------------------------------------------------------
# Copy to .env. Defaults below match the docker-compose stack.
# ---------------------------------------------------------------------------

KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
KAFKA_TOPIC=orders.v1
KAFKA_DLQ_TOPIC=orders.v1.dlq
KAFKA_CONSUMER_GROUP=orders-aggregator-v1

# Processing semantics
WINDOW_SIZE_SECONDS=60
ALLOWED_LATENESS_SECONDS=300
WATERMARK_IDLE_SECONDS=30
FLUSH_INTERVAL_SECONDS=5
MAX_BATCH_SIZE=500

# Deduplication
DEDUP_CACHE_SIZE=200000
DEDUP_LEDGER_RETENTION_HOURS=48

# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=orders
POSTGRES_USER=orders
POSTGRES_PASSWORD=orders

# Observability
METRICS_PORT=9108
LOG_LEVEL=INFO
